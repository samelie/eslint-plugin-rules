{
  "name": "@adddog/eslint-plugin-rules",
  "type": "module",
  "version": "0.0.17",
  "private": false,
  "homepage": "https://github.com/samelie/eslint-plugin-rules#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/samelie/eslint-plugin-rules.git"
  },
  "bugs": {
    "url": "https://github.com/samelie/eslint-plugin-rules/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 22",
    "pnpm": ">= 10",
    "npm": ">= 11"
  },
  "scripts": {
    "build": "unbuild",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "types": "tsgo -p tsconfig.typecheck.json",
    "test": "vitest --watch=false",
    "prepare": "unbuild",
    "release": "bumpp --yes --no-push --no-tag --release patch",
    "dev": "tsx src/index.ts",
    "knip": "knip",
    "version:patch": "npm version patch --no-git-tag-version"
  },
  "peerDependencies": {
    "knip": "^6.39.0",
    "typescript": "^7.0.2",
    "vitest": ">=5.0.3"
  },
  "devDependencies": {
    "@adddog/monorepo-consistency": "workspace:*",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/rule-tester": "^8.71.0",
    "@typescript-eslint/utils": "^8.71.0",
    "@typescript/native-preview": "beta",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "unbuild": "^3.6.1",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
